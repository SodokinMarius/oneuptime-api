# Django
DJANGO_SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL
POSTGRES_DB=oneuptime
POSTGRES_USER=oneuptime
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django DB URL (use POSTGRES_HOST=db inside Docker Compose)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Docker web port
WEB_PORT=8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email — Gmail (SMTP)
# 1) Activer la validation en 2 étapes : https://myaccount.google.com/security
# 2) Créer un mot de passe d'application : https://myaccount.google.com/apppasswords
# 3) Coller ce mot de passe (16 caractères) dans EMAIL_HOST_PASSWORD
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_TIMEOUT=10
EMAIL_FROM_NAME=OneUptime
DEFAULT_FROM_EMAIL=your-email@gmail.com
SERVER_EMAIL=your-email@gmail.com

# Frontend (liens d'activation dans les emails)
FRONTEND_URL=http://localhost:3000

# OTP / MFA
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
MFA_ISSUER_NAME=OneUptime
MFA_LOGIN_SESSION_MINUTES=5

# Webhooks
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3

# Background scheduler (service Docker « scheduler » ou: make run-scheduler)
# Jobs: run_checks + process_maintenance + process_webhook_deliveries (chaque minute)
#       purge_expired (03:00 UTC)
